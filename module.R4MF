R4OS_MODULE_MANIFEST=2
KIND=R4X
NAME=POWERSVC
VERSION=0.1.2
LANGUAGE=Zig
SOURCE=src/main.zig
ENTRY_MODE=app
APP_CLASS=service
TARGET=/R4OS/SERVICES/POWERSVC.R4X
IMAGE_SCOPE=slim
IMPORT=R4SYS:Query:1
IMPORT=R4DEV:Query:1
IMPORT=R4STD:SETTINGS_V1:1
IMPORT=R4STD:CONFIG_V1:1
IMPORT=R4STD:TEXT_V1:1
ZIG_MODULE=r4std:../../Libraries/R4STD/Bindings/Zig/r4std.zig
META=service.name=POWERSVC
META=service.args=/RUN
META=service.start=auto
META=service.enabled=yes
META=service.config=Injection\R4OS\CONFIG\SERVICES.R4S
META=runtime.workers=owned-v1
META=module.description=CPU performance profiles with exact provider return
